#include <Arduino.h>
#include <WiFi.h>
#include <FirebaseESP32.h>
#include <Adafruit_BMP280.h>
#include <Adafruit_AHTX0.h>

#define WIFI_SSID "RED_WIFI"
#define WIFI_PASSWORD "PASSWORD"
 
//Firebase Credentials
#define FIREBASE_HOST "................."
#define FIREBASE_AUTH "................."

// Define Firebase Data objects
FirebaseData fbdo;
FirebaseData firebaseData;
FirebaseJson updateSensorValue;
FirebaseJson json;

// BMP280
#define BMP_SCK  (13)
#define BMP_MISO (12)
#define BMP_MOSI (11)
#define BMP_CS   (10)

// LED verde
#define LED_VERDE 33

Adafruit_BMP280 bmp; // I2C
Adafruit_AHTX0 aht;

// Variables
float Temperatura = 0;
float Presion = 0;
float Altitud = 0;
float Humedad = 0;

bool estatus = false;


// PROTOTIPO DE LA SUBRUTINA
void updateFirebase();


void setup()
{
  Serial.begin(9600);

  // Configuración del LED verde
  pinMode(LED_VERDE, OUTPUT);
  digitalWrite(LED_VERDE, LOW);

  //////////////////////// BMP280 //////////////////////

  Serial.println(F("Prueba del BMP280 en modo forzado."));

  if (!bmp.begin())
  {
    Serial.println(F("No se encontró un sensor BMP280 válido, "
                     "verifique las conexiones o pruebe otra dirección."));

    while (1)
      delay(10);
  }

  /* Configuración predeterminada del datasheet. */
  bmp.setSampling(
    Adafruit_BMP280::MODE_FORCED,     /* Modo de operación. */
    Adafruit_BMP280::SAMPLING_X2,     /* Sobre muestreo de temperatura */
    Adafruit_BMP280::SAMPLING_X16,    /* Sobre muestreo de presión */
    Adafruit_BMP280::FILTER_X16,      /* Filtrado. */
    Adafruit_BMP280::STANDBY_MS_500   /* Tiempo de espera. */
  );

  /////////////////////////////////////////////////////////////

  //////////////////////// AHT20 //////////////////////

  if (!aht.begin())
  {
    Serial.println(F("No se encontró el sensor AHT20, verifique las conexiones."));

    while (1)
      delay(10);
  }

  Serial.println(F("AHT20 encontrado."));

  ///////////////////////////////conexion del internet
//////y la base de datos
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Conectando a Wi-Fi");

  while (WiFi.status() != WL_CONNECTED)
  {
    Serial.print(".");
    delay(300);
  }

  Serial.println();
  Serial.print("Conectado con IP: ");
  Serial.println(WiFi.localIP());
  Serial.println();

  Firebase.begin(FIREBASE_HOST, FIREBASE_AUTH);
  Firebase.reconnectWiFi(true);
}


void loop()
{
  // Obtener nueva medición del BMP280
  if (bmp.takeForcedMeasurement())
  {
    Serial.print(F("Temperatura = "));

    Temperatura = bmp.readTemperature();

    Serial.print(Temperatura);
    Serial.println(" *C");


    Serial.print(F("Presion = "));

    // Convertir de Pascales (Pa) a milímetros de mercurio (mmHg)
    Presion = bmp.readPressure() / 133.322;

    Serial.print(Presion);
    Serial.println(" mmHg");


    Serial.print(F("Altitud aproximada = "));

    Altitud = bmp.readAltitude(1013.25);

    Serial.print(Altitud);
    Serial.println(" m");
  }
  else
  {
    Serial.println("La medicion forzada fallo.");
  }


  // Obtener humedad del AHT20
  sensors_event_t humedad, temperaturaAHT;

  aht.getEvent(&humedad, &temperaturaAHT);

  Humedad = humedad.relative_humidity;

  Serial.print(F("Humedad = "));
  Serial.print(Humedad);
  Serial.println(" %");


  Serial.println();

  delay(3000);


  // Llamar a la subrutina para actualizar Firebase
  updateFirebase();
}


// =====================================================
// SUBRUTINA updateFirebase
// =====================================================

void updateFirebase()
{
  // Limpiar los datos anteriores
  updateSensorValue.clear();

  // Agregar los valores del sensor
  updateSensorValue.add("Temperatura", Temperatura);
  updateSensorValue.add("Presion", Presion);
  updateSensorValue.add("Altitud", Altitud);
  updateSensorValue.add("Humedad", Humedad);

  updateSensorValue.add("Weather", json);

  // Enviar valores a Firebase
  Firebase.RTDB.updateNode(&fbdo, "/Weather", &updateSensorValue);


  // Cambiar el estado del LED
  estatus = !estatus;

  // Escribir el valor de estatus en el LED
  digitalWrite(LED_VERDE, estatus);


  // Mostrar el estado del LED en el monitor serial
  Serial.print("Estatus: ");
  Serial.println(estatus);
}
